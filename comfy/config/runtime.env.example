# Copying this file is optional. scripts/setup.sh generates runtime.env with
# absolute paths for the current clone. Environment variables override it.
# If only COMFYUI_INSTALL_PARENT is supplied, WORKSPACE is derived as
# ${COMFYUI_INSTALL_PARENT}/ComfyUI.
COMFYUI_INSTALL_PARENT="${HOME}/.local/share/editpicture/comfy"
COMFYUI_WORKSPACE="${HOME}/.local/share/editpicture/comfy/ComfyUI"
COMFYUI_HOST="127.0.0.1"
COMFYUI_PORT="8188"
